# ITSSB device settings. EXAMPLE ONLY: every value here is fake.
#
# Production: copy to /etc/itssb/device.env, owned by root, mode 0600:
#   sudo install -o root -g root -m 0600 device.env.example /etc/itssb/device.env
# systemd injects it via EnvironmentFile=; the service user cannot (and need
# not) read the file itself. For development, pass --env-file <copy>.
#
# Missing token or origin = uploads disabled (health shows backend "unconfigured").
# It never grants default access.

# Device HTTP origin (a Convex deployment's .convex.site URL). https only;
# http is accepted for loopback test servers.
ITSSB_DEVICE_API_ORIGIN=https://REPLACE_WITH_DEVICE_HTTP_ORIGIN
# Provisioned device credential. Never commit a real one.
ITSSB_DEVICE_TOKEN=REPLACE_WITH_PROVISIONED_DEVICE_TOKEN

# Everything below is optional; defaults shown. No inline comments: systemd
# would treat them as part of the value.
# Which deployment this Pi reports to: development, staging, or production.
# Anything but production shows a banner on the driver screen.
#ITSSB_ENVIRONMENT=development
#ITSSB_DATABASE_PATH=/var/lib/itssb/device.sqlite3
#ITSSB_GPSD_HOST=127.0.0.1
#ITSSB_GPSD_PORT=2947
# The local API host must be loopback; anything else is refused.
#ITSSB_LOCAL_API_HOST=127.0.0.1
#ITSSB_LOCAL_API_PORT=8765
#ITSSB_PUBLISH_INTERVAL_SECONDS=5
#ITSSB_UPLOAD_INTERVAL_SECONDS=5
#ITSSB_MAX_BATCH_EVENTS=50
#ITSSB_MAX_BATCH_BYTES=131072
#ITSSB_HTTP_TIMEOUT_SECONDS=10
#ITSSB_LOG_LEVEL=INFO
# Optional size-capped log file (1 MB x 3 backups); otherwise stderr/journald only.
#ITSSB_LOG_FILE=
# Drivers who may unlock the touchscreen: JSON with scrypt PIN hashes made by
# `itssb-device hash-pin`. Root-owned, readable by the service group (0640).
#ITSSB_DRIVERS_FILE=/etc/itssb/drivers.json
# Built driver UI. Defaults to the package's static/ directory.
#ITSSB_DRIVER_UI_DIR=
# IANA time zone of the school's service dates. Needed to start runs.
#ITSSB_SERVICE_TIMEZONE=America/New_York
