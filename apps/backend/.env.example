# Local development only. `bunx convex dev` writes the real CONVEX_DEPLOYMENT
# to .env.local (gitignored). Server-side secrets are set in the Convex
# dashboard or with `bunx convex env set`, never in this file.
CONVEX_DEPLOYMENT=dev:example-not-a-real-deployment

# Deployment variables (NOT read from this file). Set each on the Convex
# deployment with `bunx convex env set NAME value`:
#
# Clerk issuer (Frontend API URL) for human sign-in; see README "Sign-in".
# CLERK_JWT_ISSUER_DOMAIN=https://example-name-00.clerk.accounts.dev
#
# Allows `seed:dev` (fictional data). Development deployments ONLY.
# ITSSB_ALLOW_DEV_SEED=true
