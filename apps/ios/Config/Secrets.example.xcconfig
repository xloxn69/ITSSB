// Copy to Secrets.xcconfig (gitignored) and fill in your own values.
// Never commit Secrets.xcconfig.

// Your Apple Developer Team ID (Xcode → Settings → Accounts).
ITSSB_DEVELOPMENT_TEAM = ABCDE12345

// Use your own bundle ID if you sign the app yourself.
ITSSB_BUNDLE_ID = com.example.itssb

// Your Convex deployment URL from `bunx convex dev` (apps/backend/.env.local).
// Note the $() — xcconfig treats // as a comment otherwise.
CONVEX_URL = https:/$()/example-not-real-123.convex.cloud

// Your Clerk publishable key (Clerk dashboard → API keys). Publishable keys are
// meant for apps; never put the Clerk *secret* key here. This placeholder is
// rejected by the app, which then shows "sign-in not configured".
CLERK_PUBLISHABLE_KEY = pk_test_EXAMPLE_NOT_A_REAL_KEY
