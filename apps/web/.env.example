# Copy to .env.local (gitignored) for a dev deployment. Both values are public.
# Convex deployment URL (Convex dashboard → Settings → URL & deploy key).
VITE_CONVEX_URL=https://example-fictional-123.convex.cloud
# Clerk publishable key (Clerk dashboard → API keys). Never a secret key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_EXAMPLE_ONLY_NOT_A_REAL_KEY

# Build identity (docs/14 §1-2). Public. The release runbook sets these for a
# release build; a missing or unknown environment shows a "Development" badge.
# VITE_ITSSB_ENVIRONMENT=development
# VITE_ITSSB_RELEASE=2026.11.27-abc1234
# VITE_ITSSB_REVISION=abc1234...
